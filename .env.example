# ---- GigBid environment (copy to .env; never commit .env) ----------------------------------
# Every variable the system reads. Values here are placeholders, not real secrets.

# App
APP_ENV=development                      # development | production
APP_SECRET_KEY=change-me-32-bytes-min    # JWT signing + session cookies
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=                    # Fernet key (base64, 32 bytes) for OAuth token store; `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
LOG_LEVEL=INFO
PII_MASKING=true

# Storage
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0

# Marketplace port
MARKETPLACE_MODE=gigsim                  # gigsim | upwork_live
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=dev-token
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_CLIENT_SECRET=
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/auth/upwork/callback

# MCP servers (our own)
MCP_PORTFOLIO_URL=http://localhost:8101/mcp
MCP_MARKETPLACE_URL=http://localhost:8102/mcp
MCP_WORKSPACE_URL=http://localhost:8103/mcp
MCP_BEARER_TOKEN=dev-mcp-token           # bearer auth on our HTTP MCP endpoints
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/x/repos/readonly   # read-only repos toolset
GITHUB_TOKEN=                            # PAT for the GitHub MCP server (repo read only)

# Models (open profile is mandatory; see agent/config.yaml)
MODEL_PROFILE=open                       # open | paid
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=                          # paid profile only (optional)
GEMINI_API_KEY=                          # paid profile only (optional)

# Tracing (LangSmith; Langfuse optional alternative)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Reviewer login seeded by `make seed`
REVIEWER_EMAIL=reviewer@gigbid.local
REVIEWER_PASSWORD=change-me
