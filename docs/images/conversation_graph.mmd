---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	fetch_messages(fetch_messages)
	classify(classify)
	draft_reply(draft_reply)
	approval(approval)
	send(send)
	__end__([<p>__end__</p>]):::last
	__start__ --> fetch_messages;
	approval -.-> __end__;
	approval -.-> send;
	classify -.-> __end__;
	classify -.-> draft_reply;
	draft_reply -.-> __end__;
	draft_reply -.-> approval;
	fetch_messages -.-> __end__;
	fetch_messages -.-> classify;
	send --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
