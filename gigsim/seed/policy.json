{
  "version": 1,
  "source": "student-built GigSim; mirrors data/policy_pack/policy.yaml",
  "connects": {
    "cost_per_proposal_default": 8,
    "weekly_budget_default": 80,
    "boost_allowed": false
  },
  "rules": [
    "no_off_platform_contact",
    "no_free_work",
    "no_fabrication",
    "no_guarantees",
    "untrusted_input",
    "automation_fair_use",
    "human_approval"
  ],
  "rate_limit_per_minute": 60
}
