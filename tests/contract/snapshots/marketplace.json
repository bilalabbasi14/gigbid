  "create_proposal_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "PREVIEW a proposal without sending it or spending Connects: returns exactly what would be sent and its cost. Use when the user wants a draft or preview of a proposal. `draft` needs job_id, cover_letter, bid_amount, bid_type and an idempotency_key.",
    "inputSchema": {
      "$defs": {
        "ProposalDraftIn": {
          "properties": {
            "bid_amount": {
              "exclusiveMinimum": 0,
              "title": "Bid Amount",
              "type": "number"
            },
            "bid_type": {
              "enum": [
                "fixed",
                "hourly"
              ],
              "title": "Bid Type",
              "type": "string"
            },
            "cover_letter": {
              "maxLength": 5000,
              "minLength": 50,
              "title": "Cover Letter",
              "type": "string"
            },
            "dry_run": {
              "default": false,
              "title": "Dry Run",
              "type": "boolean"
            },
            "idempotency_key": {
              "maxLength": 128,
              "minLength": 8,
              "title": "Idempotency Key",
              "type": "string"
            },
            "job_id": {
              "title": "Job Id",
              "type": "string"
            },
            "screening_answers": {
              "items": {
                "type": "string"
              },
              "title": "Screening Answers",
              "type": "array"
            }
          },
          "required": [
            "job_id",
            "cover_letter",
            "bid_amount",
            "bid_type",
            "idempotency_key"
          ],
          "title": "ProposalDraftIn",
          "type": "object"
        }
      },
      "properties": {
        "draft": {
          "$ref": "#/$defs/ProposalDraftIn"
        }
      },
      "required": [
        "draft"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "connects_remaining": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connects Remaining"
        },
        "connects_spent": {
          "default": 0,
          "title": "Connects Spent",
          "type": "integer"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotent_replay": {
          "default": false,
          "title": "Idempotent Replay",
          "type": "boolean"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "preview": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview"
        },
        "proposal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        }
      },
      "required": [
        "job_id",
        "status"
      ],
      "title": "ProposalResult",
      "type": "object"
    },
    "title": "Create proposal draft (no Connects spent)"
  },
