# Production settings for the VM. Copy to /opt/gigbid/.env.production (never commit the copy)
# and fill every value marked REQUIRED. `bash infra/vm/setup.sh` creates the copy and generates
# the random secrets.

# Public address: the VM's DNS name, e.g. gigbid-yourname.eastus.cloudapp.azure.com (REQUIRED)
SITE_ADDRESS=
# https://<SITE_ADDRESS>, filled by setup.sh
WEB_BASE_URL=

# Neon connection string with the SQLAlchemy driver prefix (REQUIRED), e.g.
# postgresql+psycopg://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Models: the open profile on Groq (REQUIRED key)
MODEL_PROFILE=open
GROQ_API_KEY=

# Random secrets (generated by setup.sh)
APP_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
GIGSIM_API_TOKEN=
MCP_BEARER_TOKEN=

# Reviewer login preloaded with a persona (the password goes in the submission)
REVIEWER_EMAIL=reviewer@gigbid.local
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml

# Simulated clients: an open model reads each proposal (a small hosted model; the VM has no room
# for a local one)
GIGSIM_CLIENT_MODE=llm
GIGSIM_CLIENT_LLM=groq:openai/gpt-oss-20b
GIGSIM_CHAOS_RATE=0.02

# Optional
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
GITHUB_TOKEN=
